{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Orca",
  "description": "Orca 2.0 documentation: run agents through the OpenAI Agents API at api.orcapods.ai, with the dashboard, the CLI, plans, and billing.",
  "colors": {
    "primary": "#111111",
    "light": "#F5F5F5",
    "dark": "#111111"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#FDFDFD",
      "dark": "#000000"
    }
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://orcapods.ai"
  },
  "favicon": "/assets/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "OpenAI Agent API",
        "href": "https://developers.openai.com/api/docs/guides/agents-api/quickstart/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://orcapods.ai"
    }
  },
  "search": {
    "prompt": "Search guides, examples, and endpoints…"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "vitesse-light",
        "dark": "vitesse-black"
      }
    },
    "eyebrows": "section"
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Start here",
                "pages": [
                  "introduction",
                  "quickstart",
                  "concepts",
                  "turn-lifecycle",
                  "glossary",
                  "migration"
